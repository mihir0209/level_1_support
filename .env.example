# ─── LLM Provider ─────────────────────────────────────────────────
# Options: "anthropic" | "azure" | "openai"
LLM_PROVIDER=anthropic

# ─── Anthropic ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
PRIMARY_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5-20251001

# ─── Azure OpenAI ─────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_PRIMARY_DEPLOYMENT=gpt-4o          # your deployment name
AZURE_FAST_DEPLOYMENT=gpt-4o-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ─── OpenAI (direct) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_PRIMARY_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# ─── GRAPH DATABASE ───────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# ─── POSTGRES (pgvector + app data) ───────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=l1_support
POSTGRES_USER=l1support
POSTGRES_PASSWORD=l1support_secret

# ─── REDIS (session cache) ────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ─── GRAPHITI (temporal KG) ───────────────────────────────────────
# Graphiti uses the same FalkorDB/Neo4j — point at FalkorDB
GRAPHITI_DB_HOST=localhost
GRAPHITI_DB_PORT=6379

# ─── MEMORY PALACE ────────────────────────────────────────────────
MEMPALACE_DATA_DIR=./data/mempalace

# ─── OBSERVABILITY ────────────────────────────────────────────────
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=l1-support-ai
LANGCHAIN_TRACING_V2=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── CRAWLING ─────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-...

# ─── TELEPHONY / VOICE (optional, Phase 3) ────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DAILY_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ─── CHATWOOT (chat frontend) ─────────────────────────────────────
CHATWOOT_API_URL=http://localhost:3000
CHATWOOT_API_KEY=
CHATWOOT_ACCOUNT_ID=1

# ─── APP ──────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
